# Copy to /opt/lexeu/.env on the VM and fill in. Never commit the real file.
#   chmod 600 .env   (only its owner can read it)

# Public hostname. sslip.io resolves 51-170-130-195.sslip.io to 51.170.130.195: a free name that
# Let's Encrypt accepts, until a real domain is pointed at the VM.
LEXEU_DOMAIN=51-170-130-195.sslip.io

# Image tag to run: a commit sha (set by the deploy workflow) or latest.
LEXEU_TAG=latest

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

GEMINI_API_KEY=

# The UI's own API key, created once the stack runs:
#   docker compose -f compose.prod.yml run --rm api lexeu keys create web-ui --rate-limit 60
# Its limit is shared by all visitors: it caps the LLM spend of the public demo.
UI_API_KEY=

# Optional: traces in Langfuse Cloud.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
