# Copy to `.env` and adjust. `.env` is git-ignored: never commit real secrets.
# Nested settings use a double underscore: SECTION__FIELD.
# Use 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and
# waits ~2 s before falling back to the IPv4-only Docker ports.

ENV=local
LOG_LEVEL=INFO
LOG_JSON=false

# Host port for the API (uv run poe dev / API container). Change if 8000 is taken.
API_PORT=8000

POSTGRES__HOST=127.0.0.1
# Host port; change it (e.g. 5433) if a local PostgreSQL already uses 5432.
POSTGRES__PORT=5432
POSTGRES__USER=lexeu
POSTGRES__PASSWORD=change-me
POSTGRES__DB=lexeu

QDRANT__URL=http://127.0.0.1:6333
# QDRANT__API_KEY=

REDIS__URL=redis://127.0.0.1:6379/0

OBJECT_STORE__ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE__ACCESS_KEY=lexeu
OBJECT_STORE__SECRET_KEY=change-me-too
OBJECT_STORE__BUCKET_RAW=lexeu-raw

EMBEDDINGS__URL=http://127.0.0.1:8081
EMBEDDINGS__MODEL_ID=BAAI/bge-m3
EMBEDDINGS__REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDINGS__CACHE_PATH=data/embeddings/bge-m3.sqlite

# API access (M5): clients send `Authorization: Bearer <key>`; create keys with `lexeu keys create`.
# AUTH__REQUIRED=false allows anonymous calls (limited per IP), for local exploration only.
AUTH__REQUIRED=true
# AUTH__DEFAULT_RATE_LIMIT_PER_MIN=30

# Answer generation (M4), through LiteLLM. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GENERATION__MODEL=gemini/gemini-3.1-flash-lite
# GENERATION__JUDGE_MODEL=gemini/gemini-3.8-flash
# GENERATION__REASONING_EFFORT=minimal

# Modal (GPU batch embedding, reranker evaluation): set by `uv run python -m modal token new`.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
